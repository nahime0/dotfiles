#!/usr/bin/env bash

# Close the current Zellij session, asking for confirmation first.
# Meant to be run from a floating pane (see the `session` keybinds in
# config/zellij/config.kdl), where $ZELLIJ_SESSION_NAME is always set.
#
# Usage:
#   zellij-close-session            kill the session (stays resurrectable)
#   zellij-close-session --delete   kill it and delete it from disk

set -euo pipefail

session="${ZELLIJ_SESSION_NAME:-}"

if [[ -z $session ]]; then
    echo "Not inside a Zellij session, nothing to close." >&2
    sleep 2
    exit 1
fi

if [[ ${1:-} == "--delete" ]]; then
    prompt="Delete session \"$session\"? It will NOT be resurrectable."
    close=(zellij delete-session --force "$session")
else
    prompt="Close session \"$session\"?"
    close=(zellij kill-session "$session")
fi

if command -v gum >/dev/null 2>&1; then
    gum confirm --default=false "$prompt" || exit 0
else
    read -rp "$prompt [y/N] " reply
    [[ $reply == [yY] ]] || exit 0
fi

exec "${close[@]}"
