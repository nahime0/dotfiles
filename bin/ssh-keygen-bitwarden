#!/bin/sh
# git's gpg.ssh.program, wrapped so that commit signing finds the key wherever
# git runs from.
#
# The signing key lives in Bitwarden's agent, but ssh-keygen only looks at
# SSH_AUTH_SOCK, and macOS overwrites that variable for every process in the
# session: com.openssh.ssh-agent declares SecureSocketWithKey = SSH_AUTH_SOCK,
# which wins over launchctl setenv. GUI applications such as Obsidian or an IDE
# therefore always see the system agent, which does not hold the key. Setting
# the socket here covers them all without touching their environment.
#
# Left alone when Bitwarden is not running, so the behaviour degrades to
# whichever agent the caller already had.
[ -S "$HOME/.bitwarden-ssh-agent.sock" ] && export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"

exec /usr/bin/ssh-keygen "$@"
