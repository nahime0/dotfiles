#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
usage() {
  cat <<'EOF'
Usage: ./setup --profile <macos|omarchy> [--apply] [--packages] [--only desktop|plugins]

Without --apply, print operations without changing the machine.
--packages installs the profile's mise tools (requires --apply).
--only desktop applies only the selected Omarchy desktop preferences.
--only plugins installs/enables the selected plugins, then applies desktop preferences.
EOF
}

profile=""; apply=false; packages=false; packages_failed=false; scope=all
while (($#)); do
  case "$1" in
    --profile) [[ $# -ge 2 ]] || { usage; exit 2; }; profile=$2; shift 2 ;;
    --apply) apply=true; shift ;;
    --packages) packages=true; shift ;;
    --only) [[ $# -ge 2 && ( $2 == desktop || $2 == plugins ) ]] || { usage; exit 2; }; scope=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

case "$profile" in
  macos|omarchy) ;;
  "") echo "A profile is required." >&2; usage; exit 2 ;;
  *) echo "Unsupported profile: $profile" >&2; exit 2 ;;
esac

if [[ "$scope" != all && ( "$profile" != omarchy || "$packages" == true ) ]]; then
  echo "--only desktop/plugins requires --profile omarchy and cannot use --packages" >&2
  exit 2
fi

export DOTFILES_ROOT="$ROOT_DIR" DOTFILES_APPLY="$apply"
source "$ROOT_DIR/lib/install.sh"
export DOTFILES_BACKUP_DIR

if [[ "$apply" == true ]]; then
  case "$profile:$(uname -s)" in
    macos:Darwin|omarchy:Linux) ;;
    *) die "Profile '$profile' is not compatible with $(uname -s)" ;;
  esac
fi

if [[ "$profile" == omarchy ]]; then
  source "$ROOT_DIR/profiles/omarchy/desktop/install.sh"
fi

if [[ "$scope" != all ]]; then
  if [[ "$scope" == plugins ]]; then
    plugin_options=()
    if [[ "$apply" == true ]]; then
      plugin_options+=(--apply)
    fi
    python3 "$ROOT_DIR/profiles/omarchy/desktop/plugins.py" "${plugin_options[@]}"
  fi
  install_desktop
  exit
fi

if [[ -r "$ROOT_DIR/profiles/$profile/bootstrap.sh" ]]; then
  source "$ROOT_DIR/profiles/$profile/bootstrap.sh"
fi

if [[ "$packages" == true ]]; then
  [[ "$apply" == true ]] || die "--packages requires --apply"
  command -v mise >/dev/null 2>&1 || die "mise is required to install profile tools"
  if [[ "$profile" == omarchy ]]; then
    command -v omarchy >/dev/null 2>&1 || die "The omarchy command was not found"
    run omarchy pkg add re2c gd
    run omarchy mise install github:illegalstudio/ggg ggg
    run omarchy mise install github:illegalstudio/ggw ggw
  fi
  # A tool that fails to install must not stop the configuration that follows:
  # with versions pinned to "latest", an upstream release whose artifact is not
  # published yet is enough to fail, and that has nothing to do with the
  # symbolic links below. Calling this in a condition also keeps `set -e` from
  # aborting inside it.
  install_mise_tools "$ROOT_DIR/profiles/$profile/mise.toml" || packages_failed=true
fi

source "$ROOT_DIR/profiles/$profile/install.sh"

if [[ "$profile" == omarchy ]]; then
  install_desktop
fi

if [[ -x "$ROOT_DIR/dotfiles-private/setup" ]]; then
  private_args=(--profile "$profile")
  [[ "$apply" == true ]] && private_args+=(--apply)
  "$ROOT_DIR/dotfiles-private/setup" "${private_args[@]}"
else
  log "Private dotfiles setup not found; skipping"
fi

if [[ "$packages_failed" == true ]]; then
  log "warning: some tools declared in profiles/$profile/mise.toml could not be"
  log "         installed; the configuration above was applied anyway. Re-run"
  log "         with --packages to retry them."
fi

if [[ "$apply" == true ]]; then
  log "Profile '$profile' installed. Backups, when needed, are in $DOTFILES_BACKUP_DIR"
else
  log "Dry run complete. Re-run with --apply after reviewing the operations above."
fi
